rules_version = '2';

// Leads are written only by the "quote" Cloud Function, which uses the Admin SDK
// and is not subject to these rules. Nothing in the browser can read or write the
// database. View leads in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
